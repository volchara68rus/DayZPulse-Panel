<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DayZPulse</RootNamespace>
    <AssemblyName>DayZPulse</AssemblyName>
    <Product>DayZPulse</Product>
    <Company>DayZPulse</Company>
    <Description>РџР°РЅРµР»СЊ СѓРїСЂР°РІР»РµРЅРёСЏ РёРіСЂРѕРІС‹Рј СЃРµСЂРІРµСЂРѕРј СЃ Р»РѕРєР°Р»СЊРЅС‹Рј РІРµР±-РёРЅС‚РµСЂС„РµР№СЃРѕРј</Description>
    <Version>2.2.6</Version>
    <FileVersion>2.2.6.0</FileVersion>
    <AssemblyVersion>2.2.6.0</AssemblyVersion>
    <ApplicationIcon>installer\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <StartupObject>DayZPulse.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- РРЅСЃС‚СЂСѓРјРµРЅС‚С‹ СЃР±РѕСЂРєРё РјРѕРґР° (pboobf) Рё Р°СЂС‚РµС„Р°РєС‚С‹ РЅРµ РІС…РѕРґСЏС‚ РІ РїР°РЅРµР»СЊ. -->
    <Compile Remove="tools\**\*.cs" />
    <Content Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Compile Remove="dist\**\*" />
    <Content Remove="dist\**\*" />
    <None Remove="dist\**\*" />
    <Compile Remove="installer\**\*" />
    <Content Remove="installer\**\*" />
    <!-- РСЃС…РѕРґРЅРёРєРё РјРѕРґР° Рё РµРіРѕ РїСЂРёРјРµСЂС‹ РЅРµ РІС…РѕРґСЏС‚ РІ РїСѓР±Р»РёРєР°С†РёСЋ РїР°РЅРµР»Рё. -->
    <Content Remove="mod\**\*" />
    <None Remove="mod\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Р’РµР±-РёРЅС‚РµСЂС„РµР№СЃ РґРѕР»Р¶РµРЅ Р»РµР¶Р°С‚СЊ СЂСЏРґРѕРј СЃ РёСЃРїРѕР»РЅСЏРµРјС‹Рј С„Р°Р№Р»РѕРј. -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
