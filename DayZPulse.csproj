<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DayZPulse</RootNamespace>
    <AssemblyName>DayZPulse</AssemblyName>
    <Product>DayZPulse</Product>
    <Company>DayZPulse</Company>
    <Description>Панель управления игровым сервером с локальным веб-интерфейсом</Description>
    <Version>2.2.1</Version>
    <FileVersion>2.2.1.0</FileVersion>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <ApplicationIcon>installer\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <StartupObject>DayZPulse.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Инструменты сборки мода (pboobf) и артефакты не входят в панель. -->
    <Compile Remove="tools\**\*.cs" />
    <Content Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <Compile Remove="dist\**\*" />
    <Content Remove="dist\**\*" />
    <None Remove="dist\**\*" />
    <Compile Remove="installer\**\*" />
    <Content Remove="installer\**\*" />
    <!-- Исходники мода и его примеры не входят в публикацию панели. -->
    <Content Remove="mod\**\*" />
    <None Remove="mod\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Веб-интерфейс должен лежать рядом с исполняемым файлом. -->
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
